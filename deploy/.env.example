# Copy to deploy/.env (git-ignored) and fill in. Generate secrets with: openssl rand -hex 32
#
# The public address. On an IU server: the domain IT gives you (Caddy then gets a certificate).
# For a local test on this machine: SITE_ADDRESS=localhost, PUBLIC_URL=https://localhost:8443,
# HTTP_PORT=8080, HTTPS_PORT=8443. (SITE_ADDRESS is what Caddy listens for INSIDE the container,
# always on 80/443; PUBLIC_URL is what the browser sees, including the host port.)
SITE_ADDRESS=hr-engage.example.edu.sa
PUBLIC_URL=https://hr-engage.example.edu.sa
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
RESEARCH_KEY=

# The first administrator, created with: docker compose --env-file deploy/.env run --rm api npm run seed:admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Daily backup time (Riyadh time); 7 daily + 4 weekly copies are kept in ./backups
BACKUP_AT=02:00
