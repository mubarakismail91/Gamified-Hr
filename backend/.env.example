# Database
DATABASE_URL="postgresql://iu_hr_user:changeme@localhost:5432/iu_hr_dev"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# File uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Admin bootstrap (used only by the seed:admin script)
SEED_ADMIN_EMAIL="admin@iu.edu.sa"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME_EN="System Administrator"
SEED_ADMIN_NAME_AR="مدير النظام"

# Research track (report Section 4.4.7). The key that turns user ids into research codes
# ("User_XXXXXXXXXXXX"). At least 32 characters; generate one with `openssl rand -hex 32`.
# Keep it outside the database, give it only to the research team, and never change it
# during a study (changing it changes every code). Leave it unset to switch the research track off.
RESEARCH_KEY=""
