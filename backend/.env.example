# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# File uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Admin bootstrap (used only by the seed:admin script)
SEED_ADMIN_EMAIL="admin@iu.edu.sa"
