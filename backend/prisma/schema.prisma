generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the
// schema file) for the CLI, and in PrismaService's adapter for the app.
datasource db {
  provider = "postgresql"
}

enum Role {
  employee
  manager
  admin
}

enum Gender {
  male
  female
}

/// Generation group only (Pew boundaries) — a birth year is never stored (data minimisation).
/// null on a User = not recorded yet; `undisclosed` = the person chose not to say.
enum Generation {
  gen_z       // born 1997–2012
  millennial  // born 1981–1996
  gen_x       // born 1965–1980
  boomer      // born 1946–1964
  undisclosed
}

/// Academic (faculty) or administrative staff. Same null/undisclosed convention as Generation.
enum StaffType {
  academic
  administrative
  undisclosed
}

enum QuestCadence {
  daily
  epic
}

enum QuestDifficulty {
  easy
  medium
  hard
}

enum QuestStatus {
  draft
  published
}

enum AssignmentStatus {
  accepted
  pending_approval
  completed
}

enum SubmissionStatus {
  pending
  approved
  denied
}

enum NotificationKind {
  xp
  badge
  social
  quest
  system
}

enum ActivityKind {
  xp
  badge
  quest
  kudo
  level
}

enum KudoValue {
  collaboration
  excellence
  initiative
  mentorship
  service
  integrity
}

enum SkillBranch {
  teaching
  research
  leadership
  digital
}

enum SkillState {
  unlocked
  in_progress
  locked
}

enum SdtScale {
  autonomy
  competence
  relatedness
}

model Department {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  managerId String?  @unique
  manager   User?    @relation("DepartmentManager", fields: [managerId], references: [id])
  members   User[]   @relation("DepartmentMembers")
  quests    Quest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String    @id @default(cuid())
  staffId            String    @unique // e.g. "IU-31002", server-generated
  nameEn             String
  nameAr             String
  initials           String    // server-generated from name, same as the demo
  titleEn            String
  titleAr            String
  email              String    @unique
  passwordHash       String
  role               Role
  gender             Gender
  generation         Generation? // optional demographic, admin-only; see enum
  staffType          StaffType?  // optional demographic, admin-only; see enum
  departmentId       String?   // null = university-wide (Admin only)
  department         Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  managesDepartment  Department? @relation("DepartmentManager")
  officeEn           String    @default("")
  officeAr           String    @default("")
  collegeEn          String    @default("")
  collegeAr          String    @default("")
  avatarTone         String    // Tailwind class string, server-assigned round robin
  totalXp            Int       @default(0)
  currentStreakDays  Int       @default(0)
  lastActivityDate   DateTime?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  featuredBadgeIds   String[]  @default([]) // badges the Employee chose to show on the leaderboard, in display order (max 4)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdQuests       Quest[]           @relation("QuestCreator")
  researchConsent     ResearchConsent?
  createdSquads       Squad[]           @relation("SquadCreator")
  squadMemberships    SquadMember[]     @relation("SquadMemberUser")
  createdChallenges   SquadChallenge[]  @relation("ChallengeCreator")
  assignments         QuestAssignment[] @relation("Assignee")
  reviewedAssignments QuestAssignment[] @relation("Reviewer")
  submissions         QuestSubmission[]
  badges              UserBadge[]
  kudosSent           Kudo[]            @relation("KudosFrom")
  kudosReceived       Kudo[]            @relation("KudosTo")
  notifications       Notification[]
  activity            ActivityLog[]
  auditEntries        AuditLog[]
  refreshTokens       RefreshToken[]
  surveyParticipation SurveyParticipation[]
  skillPaths          UserSkillPath[]
}

model Quest {
  id            String          @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String          @default("")
  descriptionAr String          @default("")
  instructionsEn String         @default("") // long-form "how to do this" guidance, shown in the detail dialog
  instructionsAr String         @default("")
  estimatedMinutes Int?
  categoryEn    String
  categoryAr    String
  cadence       QuestCadence
  difficulty    QuestDifficulty @default(medium)
  xp            Int
  steps         Int             @default(1)
  dueAt         DateTime?
  skillBranch   SkillBranch?    // which skill path completing this quest advances; null = general, no skill progress
  requireFile   Boolean         @default(false) // soft recommendation only, never enforced
  status        QuestStatus     @default(published)
  departmentId  String?         // null = university-wide (Admin-created)
  department    Department?     @relation(fields: [departmentId], references: [id])
  assigneeId    String?         // optional: single-employee targeting instead of whole department
  createdById   String
  createdBy     User            @relation("QuestCreator", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assignments   QuestAssignment[]
  subtasks      QuestSubtask[]
  attachments   QuestAttachment[]
}

/// A skill path (branch) an employee has chosen to follow. Progress itself is derived from completed quests.
model UserSkillPath {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    SkillBranch
  startedAt DateTime    @default(now())

  @@unique([userId, branch])
}

/// One checklist item under a quest. `Quest.steps` is kept equal to the number of subtasks (min 1).
model QuestSubtask {
  id            String   @id @default(cuid())
  questId       String
  quest         Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  titleEn       String
  titleAr       String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  position      Int

  completions   AssignmentSubtask[]
}

/// Which subtasks one employee has ticked off on their assignment.
model AssignmentSubtask {
  id           String          @id @default(cuid())
  assignmentId String
  assignment   QuestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subtaskId    String
  subtask      QuestSubtask    @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  completedAt  DateTime        @default(now())

  @@unique([assignmentId, subtaskId])
}

/// Explanatory file (brief, template, guide...) the quest creator attaches for employees.
model QuestAttachment {
  id         String   @id @default(cuid())
  questId    String
  quest      Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileType   String?
  fileSize   Int
  uploadedAt DateTime @default(now())
}

model QuestAssignment {
  id            String           @id @default(cuid())
  questId       String
  quest         Quest            @relation(fields: [questId], references: [id])
  employeeId    String
  employee      User             @relation("Assignee", fields: [employeeId], references: [id])
  status        AssignmentStatus @default(accepted)
  stepsDone     Int              @default(0)
  acceptedAt    DateTime         @default(now())
  submittedAt   DateTime?
  approvedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?            @relation("Reviewer", fields: [reviewedById], references: [id])
  rejectionNote String?

  submissions   QuestSubmission[]
  subtaskProgress AssignmentSubtask[]

  @@unique([questId, employeeId])
}

model QuestSubmission {
  id           String            @id @default(cuid())
  assignmentId String
  assignment   QuestAssignment   @relation(fields: [assignmentId], references: [id])
  employeeId   String
  employee     User              @relation(fields: [employeeId], references: [id])
  fileName     String?
  filePath     String?
  fileType     String?
  fileSize     Int?
  notes        String?
  status       SubmissionStatus  @default(pending)
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  feedback     String?
}

model Badge {
  id            String      @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  howToEn       String
  howToAr       String
  groupEn       String
  groupAr       String
  icon          String
  tier          String      // "bronze" | "silver" | "gold"
  criteria      Json?       // reserved for future auto-award rules; unused in Phase E

  awardedTo     UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id])
  awardedAt   DateTime @default(now())
  awardedById String?

  @@unique([userId, badgeId])
}

model Kudo {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("KudosFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("KudosTo", fields: [toUserId], references: [id])
  value      KudoValue
  messageEn  String
  messageAr  String
  createdAt  DateTime  @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  kind      ActivityKind
  textEn    String
  textAr    String
  xpDelta   Int          @default(0)
  refType   String?
  refId     String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique // hashed, not the raw cookie value
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

/**
 * Quarterly SDT pulse survey (Phase F). `status` isn't stored — it's derived
 * from opensAt/closesAt vs. now() in the service, so it can never drift out
 * of sync with the dates. `targetCount` is a snapshot of eligible Employees
 * taken when the round is created, not recomputed later.
 */
model SurveyRound {
  id            String                 @id @default(cuid())
  titleEn       String
  titleAr       String
  opensAt       DateTime
  closesAt      DateTime?
  targetCount   Int
  createdAt     DateTime               @default(now())

  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  participation SurveyParticipation[]
  researchResponses ResearchResponse[]
}

model SurveyQuestion {
  id      String      @id @default(cuid())
  roundId String
  round   SurveyRound @relation(fields: [roundId], references: [id])
  scale   SdtScale
  textEn  String
  textAr  String
  order   Int
}

/**
 * Deliberately has no userId — anonymity by construction, not by policy.
 * `answers` is { [questionId]: 1-5 }. Who *completed* the round (for
 * reminders / the participation XP) is tracked separately in
 * SurveyParticipation, which never touches this table.
 */
/// Anonymous by construction: no user reference, no timestamp, and a random (not time-ordered)
/// id, so a response can't be matched to a SurveyParticipation row by time or by insertion order.
/// The coarse group tags are copied from the respondent when they submit, with `undisclosed`
/// and "not recorded" both stored as null. Group results are only shown for groups of 5 or more.
model SurveyResponse {
  id         String      @id @default(uuid())
  roundId    String
  round      SurveyRound @relation(fields: [roundId], references: [id])
  answers    Json
  generation Generation?
  staffType  StaffType?
}

model SurveyParticipation {
  id          String      @id @default(cuid())
  roundId     String
  round       SurveyRound @relation(fields: [roundId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  completedAt DateTime    @default(now())

  @@unique([roundId, userId])
}

// Read-only reference catalog (Phase F) — same illustrative state/level for
// every viewer, matching the frontend's pre-existing behavior exactly. Not
// yet per-user; see the Phase F decision log for why.
/// Catalog only. `state` and `level` are legacy demo values — real per-employee progress is computed in SkillsService.
model Skill {
  id            String      @id @default(cuid())
  nameEn        String
  nameAr        String
  branch        SkillBranch
  descriptionEn String
  descriptionAr String
  state         SkillState
  level         Int
  maxLevel      Int
  requires      String[] // ids of prerequisite Skills
  col           Int
  row           Int
}

/// Research track (Track B, report Section 4.4.7): an employee's opt-in consent. Deleting the row = withdrawn.
/// Only answers given while consent exists are linked; earlier anonymous answers can never be linked.
model ResearchConsent {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id])
  consentVersion String   // which version of the consent text they agreed to
  consentedAt    DateTime @default(now())
}

/// A consenting participant's survey answers, stored under their research code (a keyed hash of the
/// user id, made with RESEARCH_KEY, which is never stored in the database). There is no user id here,
/// so the database alone can't map a code back to a person; the research team can, with the key.
model ResearchResponse {
  id      String      @id @default(uuid())
  code    String
  roundId String
  round   SurveyRound @relation(fields: [roundId], references: [id])
  answers Json

  @@unique([code, roundId])
  @@index([code])
}

enum SquadMemberStatus {
  invited // waiting for the invitee to accept (employee-led squads only)
  active
}

enum ChallengeMetric {
  quests_completed // quests approved for squad members between startsAt and endsAt
  xp_earned        // XP squad members earned between startsAt and endsAt
}

/// A team of 3–6 employees (FR9). Created by an employee (who invites colleagues) or by a
/// manager/admin (who assigns members directly). Members may come from any department.
/// Ranked on the team leaderboard only once it has at least 3 active members.
model Squad {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("SquadCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  members          SquadMember[]
  challengeEntries SquadChallengeEntry[]
}

/// One row per person per squad. A person can be ACTIVE in at most one squad at a time
/// (enforced by a partial unique index in the migration) but may hold several pending invites.
model SquadMember {
  id          String            @id @default(cuid())
  squadId     String
  squad       Squad             @relation(fields: [squadId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("SquadMemberUser", fields: [userId], references: [id])
  status      SquadMemberStatus
  invitedById String?
  createdAt   DateTime          @default(now())
  joinedAt    DateTime?

  @@unique([squadId, userId])
  @@index([userId])
}

/// A shared target published by a manager or admin that any squad can join (cross-department).
model SquadChallenge {
  id            String          @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String          @default("")
  descriptionAr String          @default("")
  metric        ChallengeMetric
  target        Int
  bonusXp       Int
  startsAt      DateTime
  endsAt        DateTime
  createdById   String
  createdBy     User            @relation("ChallengeCreator", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  entries SquadChallengeEntry[]
}

/// A squad taking part in a challenge. completedAt is set exactly once, when the target is first
/// reached; that same update is what awards the bonus, so it can never be paid twice.
model SquadChallengeEntry {
  id          String         @id @default(cuid())
  squadId     String
  squad       Squad          @relation(fields: [squadId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   SquadChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  joinedAt    DateTime       @default(now())
  completedAt DateTime?

  @@unique([squadId, challengeId])
}

